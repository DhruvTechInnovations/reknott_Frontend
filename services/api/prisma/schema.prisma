generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  PAUSED
  SUSPENDED
  CLOSED
}

enum ProfileStatus {
  DRAFT
  REVIEW
  ACTIVE
  PAUSED
  REJECTED
}

enum Gender {
  WOMAN
  MAN
  ANOTHER_IDENTITY
}

enum Visibility {
  PRIVATE
  COMPATIBLE_ONLY
  DISCOVERABLE
}

enum PhotoVisibility {
  PRIVATE
  APPROVED_INTERESTS
  REGISTERED_MEMBERS
}

enum ReviewStatus {
  PENDING
  APPROVED
  VERIFIED
  REJECTED
  EXPIRED
}

enum VerificationType {
  PHONE
  EMAIL
  IDENTITY
  AGE
  ELIGIBILITY
  EMPLOYMENT
  EDUCATION
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  BLOCKED
}

enum MembershipStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  CLOSED
}

model User {
  id                String        @id @default(uuid())
  cognitoSubject    String        @unique
  email             String?       @unique
  phone             String?       @unique
  status            AccountStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  profile           Profile?
  sentInterests     Interest[]    @relation("SentInterests")
  receivedInterests Interest[]    @relation("ReceivedInterests")
  memberships       Membership[]
  reportsFiled      Report[]      @relation("ReportsFiled")
  reportsAgainst    Report[]      @relation("ReportsAgainst")
  auditLogs         AuditLog[]
}

model Profile {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String
  dateOfBirth   DateTime
  gender        Gender
  city          String
  country       String        @default("India")
  languages     String[]      @default([])
  profession    String?
  education     String?
  bio           String?       @db.Text
  familyContext String?       @db.Text
  partnerIntent String?       @db.Text
  status        ProfileStatus @default(DRAFT)
  visibility    Visibility    @default(PRIVATE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  preferences   Preference?
  photos        Photo[]
  verifications Verification[]
  @@index([status, visibility, city])
  @@index([gender, dateOfBirth])
}

model Preference {
  id                     String   @id @default(uuid())
  profileId              String   @unique
  profile                Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ageMin                 Int?
  ageMax                 Int?
  cities                 String[] @default([])
  languages              String[] @default([])
  childPreference        String?
  relocationPreference   String?
  essentialCriteria      Json?
  flexibleCriteria       Json?
  updatedAt              DateTime @updatedAt
}

model Photo {
  id          String          @id @default(uuid())
  profileId   String
  profile     Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  objectKey   String          @unique
  checksum    String
  contentType String
  visibility  PhotoVisibility @default(PRIVATE)
  status      ReviewStatus    @default(PENDING)
  createdAt   DateTime        @default(now())
  @@index([profileId, status])
}

model Verification {
  id          String           @id @default(uuid())
  profileId   String
  profile     Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type        VerificationType
  status      ReviewStatus     @default(PENDING)
  providerRef String?
  reviewedAt  DateTime?
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  @@unique([profileId, type])
}

model Interest {
  id           String         @id @default(uuid())
  senderId     String
  recipientId  String
  sender       User           @relation("SentInterests", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User           @relation("ReceivedInterests", fields: [recipientId], references: [id], onDelete: Cascade)
  status       InterestStatus @default(PENDING)
  message      String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  conversation Conversation?
  @@unique([senderId, recipientId])
  @@index([recipientId, status])
}

model Conversation {
  id         String    @id @default(uuid())
  interestId String    @unique
  interest   Interest  @relation(fields: [interestId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  messages   Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  body           String       @db.Text
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  @@index([conversationId, createdAt])
}

model Membership {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode           String
  status             MembershipStatus @default(ACTIVE)
  providerCustomerId String?
  providerPaymentId  String?
  startsAt           DateTime          @default(now())
  endsAt             DateTime?
  createdAt          DateTime          @default(now())
  @@index([userId, status])
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reportedUserId String
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User         @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)
  category       String
  details        String?      @db.Text
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([reportedUserId, status])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  ipHash     String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
  @@index([createdAt])
}
